# ==============================================================================
# Enterprise AI Project .gitignore
# Frameworks: Python, Jupyter, PyTorch, FAISS, LangChain, React
# ==============================================================================

# 1. Environment Variables & Secrets
.env
.env.*
!.env.template
*.pem
secrets/
credentials/

# 2. Python & Virtual Environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
venv/
.venv/
ENV/
env.bak/
venv.bak/

# 3. Jupyter Notebook & Colab
.ipynb_checkpoints/
*/.ipynb_checkpoints/
.colab/

# 4. VS Code & IDEs
.vscode/
.idea/
*.swp
*.swo

# 5. Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

# 6. Logs & Caches
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pytest_cache/
.coverage
htmlcov/

# 7. Frontend (React/Node)
frontend/node_modules/
frontend/dist/
frontend/build/
.npm/

# 8. Data & Temporary Files
data/processed/*
!data/processed/.gitkeep
data/archive/*
!data/archive/.gitkeep
tmp/
temp/

# 9. AI, ML, & Vector DB Artifacts
# Do not commit raw embeddings, models, or vector stores
data/chunks/*
!data/chunks/.gitkeep
data/embeddings/*
!data/embeddings/.gitkeep
data/vector_db/*
!data/vector_db/.gitkeep
data/knowledge_graph/*
!data/knowledge_graph/.gitkeep
*.faiss
*.pkl
*.pt
*.pth
*.h5
*.onnx
models/
data/raw/*
!data/raw/.gitkeep

# Notebook Outputs
data/inventory/*
!data/inventory/.gitkeep

data/ocr/*
!data/ocr/.gitkeep

data/rag/*
!data/rag/.gitkeep

# Python bytecode
*.pyo
*.pyd
